{
    "name": "gatomontes/athmovil-php",
    "description": "Unofficial PHP client for the ATH Movil ecommerce Payment Button API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*"
    },
    "suggest": {
        "ext-curl": "Required for the included CurlTransport"
    },
    "autoload": {
        "psr-4": {
            "AthMovil\\": "src/"
        }
    },
    "scripts": {
        "test": "@php tests/run.php"
    },
    "homepage": "https://github.com/gatomontes/athmovil-php",
    "keywords": [
        "athmovil",
        "payments",
        "puerto-rico",
        "simulation"
    ],
    "support": {
        "issues": "https://github.com/gatomontes/athmovil-php/issues",
        "source": "https://github.com/gatomontes/athmovil-php"
    }
}
